#!/usr/bin/env bash
# fbox-launch — Assemble Dynamic SOUL.md then launch Hermes
# Usage: fbox-launch <agent_slug> [--head <head_name>] [hermes_args...]
#
# Assembles SOUL.md via assemble_soul.py, then execs Hermes with the assembled SOUL.

set -euo pipefail

AGENT="${1:?Usage: fbox-launch <agent_slug> [--head <head_name>] [hermes_args...]}"
shift

# Validate agent
case "$AGENT" in
    zeon7|leon|gemma|otec|wolf)
        ;;
    *)
        echo "Unknown agent: $AGENT (valid: zeon7, leon, gemma, otec, wolf)" >&2
        exit 1
        ;;
esac

CONFIG="/foreverbox_data/profiles/$AGENT/config.yaml"
if [[ ! -f "$CONFIG" ]]; then
    echo "Config not found: $CONFIG" >&2
    exit 1
fi

HEAD=""
# Check for --head argument
if [[ "${1:-}" == "--head" ]]; then
    HEAD="${2:-}"
    shift 2
fi

if [[ -z "$HEAD" ]]; then
    # Fallback to extracting provider from config.yaml if no explicit head is given
    PROVIDER=$(
        grep -m1 'provider:' "$CONFIG" \
        | head -1 \
        | awk '{print $2}' \
        | sed 's/["'"'"']//g'
    )
    HEAD="${PROVIDER:-ollama}"
fi

echo "Assembling SOUL for $AGENT (head/provider: $HEAD)..."
python3 /foreverbox_data/bin/assemble_soul.py "$AGENT" "$HEAD"

echo "Launching Hermes..."
exec hermes --profile "$AGENT" "$@"

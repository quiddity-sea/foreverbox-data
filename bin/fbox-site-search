#!/usr/bin/env python3
"""
fbox-site-search — CLI wrapper for semantic search across website databases.
Usage: fbox-site-search "search query" [limit]
"""

import sys
import json
import requests
import subprocess
import numpy as np

EMBEDDING_URL = "http://127.0.0.1:8900/embed"
DB_NAME = "the_everything_cube_0_0_0"

def get_query_embedding(query):
    try:
        res = requests.post(EMBEDDING_URL, json={"texts": [query]}, timeout=5)
        if res.status_code == 200:
            hex_emb = res.json().get("embeddings", [])[0]
            raw_bytes = bytes.fromhex(hex_emb)
            return np.frombuffer(raw_bytes, dtype=np.float32)
    except Exception as e:
        print("Embedding error:", e, file=sys.stderr)
    return None

def cosine_similarity(v1, v2):
    dot = np.dot(v1, v2)
    norm1 = np.linalg.norm(v1)
    norm2 = np.linalg.norm(v2)
    if norm1 == 0 or norm2 == 0:
        return 0.0
    return float(dot / (norm1 * norm2))

def search_site_vectors(query, limit=5):
    query_vec = get_query_embedding(query)
    
    # Fetch vectors from quiddity_sea
    cmd = ["mariadb", "-u", "zeon7_user", "-pF0reverb0x#2o26sql", "-B", "-N", DB_NAME, "-e", "SELECT quiddity_id, source_table, source_id, source_db, raw_text, HEX(embedding) FROM quiddity_sea;"]
    process = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    stdout, stderr = process.communicate()
    
    if process.returncode != 0:
        print(f"Error querying quiddity_sea: {stderr}", file=sys.stderr)
        return
        
    results = []
    
    for line in stdout.strip().split('\n'):
        if not line:
            continue
        parts = line.split('\t')
        if len(parts) < 6:
            continue
            
        qid, table, sid, db, raw_text, hex_emb = parts[0], parts[1], parts[2], parts[3], parts[4], parts[5]
        
        score = 0.0
        if query_vec is not None and hex_emb:
            raw_bytes = bytes.fromhex(hex_emb)
            row_vec = np.frombuffer(raw_bytes, dtype=np.float32)
            score = cosine_similarity(query_vec, row_vec)
        else:
            # Fallback simple keyword match
            if query.lower() in raw_text.lower():
                score = 0.5
                
        if score > 0.0:
            snippet = raw_text[:200] + "..." if len(raw_text) > 200 else raw_text
            results.append({
                "quiddity_id": int(qid),
                "score": round(score, 4),
                "source_db": db,
                "source_table": table,
                "source_id": int(sid),
                "snippet": snippet
            })
            
    results.sort(key=lambda x: x["score"], reverse=True)
    results = results[:limit]
    
    print(json.dumps(results, indent=2))

if __name__ == '__main__':
    if len(sys.argv) < 2:
        print("Usage: fbox-site-search <query> [limit]")
        sys.exit(1)
        
    query = sys.argv[1]
    limit = int(sys.argv[2]) if len(sys.argv) > 2 else 5
    search_site_vectors(query, limit)
